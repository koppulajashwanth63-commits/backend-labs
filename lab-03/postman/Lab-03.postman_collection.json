{
  "info": {
    "name": "My Collection",
    "description": "Lab 3 - Books REST API. Use with the Lab 03 environment ({{baseUrl}} = http://localhost:3000). Run top to bottom: Post data saves {{newBookId}} so Put data and Delete data act on the book just created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Success cases",
      "item": [
        {
          "name": "Get data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns a JSON array of books\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "  pm.expect(body[0]).to.have.all.keys(\"id\", \"title\", \"author\", \"price\", \"pages\");",
                  "});",
                  "",
                  "pm.test(\"X-Total-Count header reports 10 seeded books\", function () {",
                  "  pm.expect(pm.response.headers.get(\"X-Total-Count\")).to.eql(\"10\");",
                  "});",
                  "",
                  "pm.test(\"Default limit is 10\", function () {",
                  "  pm.expect(pm.response.json().length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/"
          }
        },
        {
          "name": "Get data - search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every returned title contains 'clean' (case-insensitive)\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "  body.forEach(function (book) {",
                  "    pm.expect(book.title.toLowerCase()).to.include(\"clean\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/?search_q=clean"
          }
        },
        {
          "name": "Get data - sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns at most 3 books in descending price order\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.length).to.be.at.most(3);",
                  "  for (let i = 1; i < body.length; i++) {",
                  "    pm.expect(body[i - 1].price).to.be.at.least(body[i].price);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=3"
          }
        },
        {
          "name": "Get data - price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every price is between 300 and 500\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "  body.forEach(function (book) {",
                  "    pm.expect(book.price).to.be.at.least(300);",
                  "    pm.expect(book.price).to.be.at.most(500);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/?min_price=300&max_price=500"
          }
        },
        {
          "name": "Get data - pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Second page has 5 books and starts after the first 5 ids\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.length).to.eql(5);",
                  "  pm.expect(body[0].id).to.be.greaterThan(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/?limit=5&offset=5"
          }
        },
        {
          "name": "Get one data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns the book with id 1\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(1);",
                  "  pm.expect(body.title).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/1/"
          }
        },
        {
          "name": "Post data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Returns a message and the new book id\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql(\"Book created\");",
                  "  pm.expect(body.bookId).to.be.a(\"number\");",
                  "  pm.collectionVariables.set(\"newBookId\", body.bookId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"price\": 550,\n  \"pages\": 412\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books/"
          }
        },
        {
          "name": "Get data - created book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns the created book\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get(\"newBookId\")));",
                  "  pm.expect(body.title).to.eql(\"Dune\");",
                  "  pm.expect(body.price).to.eql(550);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{newBookId}}/"
          }
        },
        {
          "name": "Put data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
