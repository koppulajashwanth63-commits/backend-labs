          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{newBookId}}/"
          }
        },
        {
          "name": "Get data - after delete (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 after delete\", function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Message explains the record is gone\", function () {",
                  "  pm.expect(pm.response.json().message).to.include(\"not found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{newBookId}}/"
          }
        }
      ]
    },
