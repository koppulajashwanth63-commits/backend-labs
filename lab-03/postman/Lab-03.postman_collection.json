                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune Messiah\",\n  \"author\": \"Frank Herbert\",\n  \"price\": 575,\n  \"pages\": 336\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books/{{newBookId}}/"
          }
        },
        {
          "name": "Get data - verify put",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All fields were replaced\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.title).to.eql(\"Dune Messiah\");",
                  "  pm.expect(body.price).to.eql(575);",
                  "  pm.expect(body.pages).to.eql(336);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{newBookId}}/"
          }
        },
